# -----------------------------------------------------------------------------
# Copy to .env.local for development, or set in Vercel > Project > Settings >
# Environment Variables for production. NEVER commit the filled-in file —
# .env and .env*.local are gitignored.
# -----------------------------------------------------------------------------

# --- SMTP (GoDaddy) — required for the booking form -------------------------
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=booking@nvgcleaningservices.co.uk
SMTP_PASS=your_godaddy_email_password
SMTP_FROM=booking@nvgcleaningservices.co.uk
SMTP_TO=booking@nvgcleaningservices.co.uk

# --- Public site config ------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://nvgcleaningservices.co.uk

# GA4 measurement ID, e.g. G-ABC123XYZ.
# Leave EMPTY to disable analytics entirely — the tag is only injected when set,
# so no placeholder script is ever shipped to production.
NEXT_PUBLIC_GA_ID=

# --- takepayments (Payzone UK) — card payments ------------------------------
# All four come from the MMS at https://mms.tponlinepayments2.com
#   Merchant ID / password : Account Admin -> Gateway Account Admin
#   Pre-shared key / hash  : Account Admin -> Gateway Account Settings
#
# Leave blank to turn payments off entirely: the booking form then behaves as a
# plain enquiry form, with no invoice or payment link.
TAKEPAYMENTS_MERCHANT_ID=
TAKEPAYMENTS_PASSWORD=
TAKEPAYMENTS_PRESHARED_KEY=

# MUST match the hash method set on the gateway account, or every transaction
# is rejected as tampered. One of: SHA1, MD5, SHA256, SHA512, HMACSHA1, HMACMD5.
TAKEPAYMENTS_HASH_METHOD=SHA1

# Signs the payment links sent in invoice emails. Optional: falls back to
# TAKEPAYMENTS_PRESHARED_KEY. Set explicitly to invalidate outstanding payment
# links without changing your gateway credentials.
BOOKING_LINK_SECRET=
